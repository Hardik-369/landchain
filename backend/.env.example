# LANDCHAIN backend - environment template
# Copy to .env and adjust. Never commit the real .env file.

PORT=5000
HOST=0.0.0.0

# Comma separated origins allowed to call the API (the Next.js frontend).
# Use * for local demos only.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Secret used to sign session tokens and pepper OTP/PAN hashes.
# CHANGE THIS before any shared deployment.
AUTH_SECRET=landchain-dev-secret-change-me
SESSION_TTL_SECONDS=43200

# OTP simulation
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# When true the API returns devOtp so the frontend can display it.
OTP_DEV_MODE=true
# Fixed demo code accepted while OTP_DEV_MODE is on. Leave empty for random codes.
OTP_DEMO_CODE=123456

# Demo convenience: when true, unauthenticated requests act as the seeded
# demo user so the frontend (which does not send a token) stays functional.
# Set to false to enforce real Bearer tokens.
DEMO_ALLOW_ANONYMOUS=true
DEMO_ADMIN_BYPASS=true

# Storage
BACKUP_RETENTION=25
