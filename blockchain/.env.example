# LANDCHAIN - blockchain module environment
#
# Copy to .env and fill in. NEVER commit the real .env file, and NEVER commit a
# private key. All values below are read from the process environment only.

# ---------------------------------------------------------------------------
# Network - Hedera Testnet only. Leave these at the defaults.
# ---------------------------------------------------------------------------
HEDERA_NETWORK=testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
HEDERA_EXPLORER_URL=https://hashscan.io/testnet

# ---------------------------------------------------------------------------
# Operator account - pays for and signs server-side transactions.
# Create one free at https://portal.hedera.com (choose "Testnet").
# Key may be a DER encoded private key (302e...) or a raw ECDSA/ED25519 key.
# ---------------------------------------------------------------------------
HEDERA_OPERATOR_ID=0.0.0000000
HEDERA_OPERATOR_KEY=

# ---------------------------------------------------------------------------
# Optional: separate keys for the roles used by the contracts.
# Defaults to the operator key when unset. Use distinct accounts in production.
# ---------------------------------------------------------------------------
HEDERA_ADMIN_KEY=
HEDERA_VERIFIER_KEY=
HEDERA_OPERATOR_CONTRACT_KEY=

# ---------------------------------------------------------------------------
# Contract introspection / operator account for EVM deployments (Hardhat).
# ---------------------------------------------------------------------------
# EVM address (0x...) of the operator, needed to sign contract deployments.
HEDERA_OPERATOR_EVM_ADDRESS=
# Private key in the form Hedera expects for the JSON-RPC relay.
HEDERA_OPERATOR_EVM_KEY=

# ---------------------------------------------------------------------------
# Deployed addresses - filled in by `npm run deploy:testnet`.
# ---------------------------------------------------------------------------
PROPERTY_REGISTRY_ADDRESS=
INVESTMENT_POOL_ADDRESS=
TOKEN_ALLOCATION_ADDRESS=
RESALE_CONTRACT_ADDRESS=

# ---------------------------------------------------------------------------
# Hedera Consensus Service topic used as the append-only activity log.
# `npm run topic:create` prints the ID to place here.
# ---------------------------------------------------------------------------
HEDERA_PROPERTY_TOPIC_ID=

# ---------------------------------------------------------------------------
# Optional runtime tuning
# ---------------------------------------------------------------------------
# Fee cap (tinybar) applied to every HCS message. Default 2 HBAR.
HCS_MAX_FEE_TINYBAR=200000000
# Default token decimals for property units. Units are whole, so 0.
HTS_TOKEN_DECIMALS=0
