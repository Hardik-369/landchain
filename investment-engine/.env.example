# LANDCHAIN investment engine - environment
# Copy to investment-engine/.env. Never commit the real file.

# HTTP
PORT=5100
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:5100

# Storage: defaults to backend/data so the engine writes Contributor 2's
# investments.json / investors.json / resaleListings.json / ownershipHistory.json
# / transactions.json / tokenRecords.json (no separate database).
# DATA_DIR=C:/path/to/landchain/backend/data

# Ledger (Contributor 3's blockchain module)
#   auto  - use Hedera when blockchain/.env is configured, otherwise record
#           everything unanchored and say so in every response
#   live  - require Hedera; a missing configuration is a hard error
#   local - never call the blockchain module
ENGINE_LEDGER_MODE=auto

# Resale unit transfers on HTS are wallet/escrow-signed. Enable only when
# ENGINE_LEDGER_SIGNER_KEY is a key that may sign for the seller's account.
ENGINE_LEDGER_TRANSFER_ON_RESALE=false
ENGINE_LEDGER_SIGNER_KEY=

# Buyer reservation window for a resale listing (seconds)
RESALE_RESERVATION_TTL_SECONDS=900
